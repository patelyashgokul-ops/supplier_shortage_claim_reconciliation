<odoo>
<record id="view_prepare_wizard" model="ir.ui.view"><field name="name">shortage.prepare.wizard</field><field name="model">supplier.shortage.prepare.wizard</field><field name="arch" type="xml"><form string="Prepare Draft Claim"><div class="alert alert-info" role="status">One Purchase Order per claim. Quantities reserve reviewed evidence; they are not settled quantities.</div><field name="claim_line_id" invisible="1"/><field name="line_ids"><list editable="bottom" create="0" delete="0"><field name="detection_id" readonly="1"/><field name="available_qty"/><field name="quantity"/><field name="product_uom_id"/></list></field><footer><button name="action_prepare" type="object" string="Prepare Draft Claim" class="btn-primary"/><button string="Cancel" special="cancel"/></footer></form></field></record>
<record id="view_evidence_form" model="ir.ui.view"><field name="name">shortage.claim.evidence.form</field><field name="model">supplier.shortage.claim.evidence</field><field name="arch" type="xml"><form create="1" delete="0"><header><button name="action_verify" type="object" string="Verify Evidence" groups="supplier_shortage_claim_reconciliation.group_claim_manager"/><button name="action_reject" type="object" string="Reject" groups="supplier_shortage_claim_reconciliation.group_claim_manager"/><button name="action_request_more" type="object" string="Request More Evidence" groups="supplier_shortage_claim_reconciliation.group_claim_manager"/><field name="verification_state" widget="statusbar"/></header><sheet><div class="alert alert-info" role="status">Verification confirms internal relevance only. Retain original evidence; add a new record for corrected documents.</div><group><group><field name="claim_id" readonly="id"/><field name="claim_line_id" domain="[('claim_id','=',claim_id)]"/><field name="company_id"/><field name="evidence_type" readonly="id"/><field name="description"/></group><group><field name="source_purchase_id" readonly="id"/><field name="source_picking_id" readonly="id"/><field name="source_bill_id" readonly="id"/><field name="upload_data" filename="filename" invisible="attachment_id"/><field name="filename" readonly="id"/><field name="attachment_id" readonly="1"/><button name="action_open_document" type="object" string="Open Supporting Document"/></group></group><group string="Internal Evidence Review"><field name="verification_note"/><field name="verified_by"/><field name="verified_at"/></group></sheet></form></field></record>
<record id="view_claim_preparation" model="ir.ui.view"><field name="name">shortage.claim.preparation</field><field name="model">supplier.shortage.claim</field><field name="inherit_id" ref="view_claim_form"/><field name="arch" type="xml">
<xpath expr="//header" position="inside"><button name="action_check_preparation" type="object" string="Check Current Sources" groups="supplier_shortage_claim_reconciliation.group_claim_user"/><button name="action_revalidate_preparation" type="object" string="Accept Renewed Source Review" invisible="state != 'draft'" groups="supplier_shortage_claim_reconciliation.group_claim_manager"/></xpath>
<xpath expr="//notebook" position="before"><group string="Claim Preparation"><field name="preparation_status" widget="badge"/><field name="required_evidence_count"/><field name="shortage_reason" readonly="state != 'draft'"/><field name="manual_exception_reason" readonly="state != 'draft'"/><field name="correction_reason" readonly="state != 'draft'"/></group><div class="alert alert-info" role="status">Submission validates reviewed candidates, source freshness, available quantities and verified evidence. An incomplete manual draft cannot be submitted. Provisional claim amounts are not recovery.</div></xpath>
<xpath expr="//field[@name='claim_line_ids']/list" position="inside"><field name="detection_id" optional="show" readonly="1"/><field name="allocation_state" widget="badge"/><field name="allocated_qty"/><field name="candidate_qty" optional="hide"/><field name="available_qty" optional="hide"/><button name="action_bind_candidate_dialog" type="object" string="Link Reviewed Candidate" invisible="detection_id or allocation_state == 'released'" groups="supplier_shortage_claim_reconciliation.group_claim_user"/><button name="action_release_allocation" type="object" string="Release / Exclude Line" groups="supplier_shortage_claim_reconciliation.group_claim_manager"/></xpath>
<xpath expr="//field[@name='claim_line_ids']/form" position="inside"><group string="Reviewed Candidate Reservation"><field name="detection_id"/><field name="allocation_state"/><field name="allocated_qty"/><field name="candidate_qty"/><field name="available_qty"/></group><group string="Original Preparation Evidence"><field name="preparation_snapshot" readonly="1"/><field name="allocation_basis" readonly="1"/></group></xpath>
<xpath expr="//notebook" position="inside"><page string="Evidence"><field name="evidence_ids" context="{'default_claim_id':id}"><list><field name="evidence_type"/><field name="description"/><field name="claim_line_id"/><field name="verification_state" widget="badge"/><field name="verified_by"/><field name="verified_at"/><button name="action_open_document" type="object" string="Open"/></list></field></page></xpath>
</field></record>
<record id="view_detection_preparation" model="ir.ui.view"><field name="name">shortage.detection.preparation</field><field name="model">supplier.shortage.receipt.exception</field><field name="inherit_id" ref="view_detection_form"/><field name="arch" type="xml"><xpath expr="//header" position="inside"><button name="action_prepare_claim_dialog" type="object" string="Prepare Draft Claim" class="btn-primary" invisible="not preparation_eligible" groups="supplier_shortage_claim_reconciliation.group_claim_user"/><button name="action_view_allocated_claims" type="object" string="Existing Allocated Claims"/></xpath><xpath expr="//notebook" position="before"><group string="Quantity Reservations"><field name="allocated_qty"/><field name="available_qty"/><field name="preparation_eligible"/><field name="allocation_integrity_blocked"/><field name="allocation_quantity_known"/></group></xpath><xpath expr="//notebook" position="inside"><page string="Claim Allocations"><field name="allocation_line_ids" readonly="1"><list create="0" edit="0" delete="0"><field name="claim_id"/><field name="purchase_line_id"/><field name="allocated_qty"/><field name="allocation_state"/></list></field></page></xpath></field></record>
<record id="view_detection_preparation_list" model="ir.ui.view"><field name="name">shortage.detection.preparation.list</field><field name="model">supplier.shortage.receipt.exception</field><field name="inherit_id" ref="view_detection_list"/><field name="arch" type="xml"><xpath expr="//field[@name='candidate_qty']" position="after"><field name="allocated_qty"/><field name="available_qty"/><field name="preparation_eligible" optional="hide"/><field name="allocation_integrity_blocked" optional="hide"/></xpath></field></record>
<record id="action_prepare_candidates" model="ir.actions.server"><field name="name">Prepare Draft Claim</field><field name="model_id" ref="model_supplier_shortage_receipt_exception"/><field name="binding_model_id" ref="model_supplier_shortage_receipt_exception"/><field name="state">code</field><field name="code">action = records.action_prepare_claim_dialog()</field><field name="group_ids" eval="[(4, ref('group_claim_user'))]"/></record>
<record id="view_company_evidence_policy" model="ir.ui.view"><field name="name">company.shortage.evidence.policy</field><field name="model">res.company</field><field name="inherit_id" ref="base.view_company_form"/><field name="arch" type="xml"><xpath expr="//notebook" position="inside"><page string="Claim Evidence Policy"><group><field name="ssc_min_verified_evidence"/><field name="ssc_evidence_max_mb"/><field name="ssc_evidence_extensions"/></group><p>File extension and size validation is not malware scanning. Internal evidence verification is not financial approval.</p></page></xpath></field></record>
<record id="view_evidence_policy_wizard" model="ir.ui.view"><field name="name">shortage.evidence.policy.wizard</field><field name="model">supplier.shortage.evidence.policy.wizard</field><field name="arch" type="xml"><form string="Claim Evidence Policy"><group><field name="company_id"/><field name="minimum_verified"/><field name="maximum_mb"/><field name="extensions"/></group><div class="alert alert-info" role="status">Configuration does not grant claim preparation, evidence verification or financial approval permissions. File policy checks are not malware scanning.</div><footer><button name="action_apply" type="object" string="Apply Company Policy" class="btn-primary"/><button string="Cancel" special="cancel"/></footer></form></field></record>
<record id="action_evidence_policy_wizard" model="ir.actions.act_window"><field name="name">Claim Evidence Policy</field><field name="res_model">supplier.shortage.evidence.policy.wizard</field><field name="view_mode">form</field><field name="target">new</field></record>
<menuitem id="menu_evidence_policy" name="Claim Evidence Policy" parent="menu_recovery_root" action="action_evidence_policy_wizard" sequence="90" groups="group_module_admin"/>
</odoo>
