<odoo>
<record id="view_evidence_advanced" model="ir.ui.view"><field name="name">claim.evidence.advanced</field><field name="model">supplier.shortage.claim.evidence</field><field name="inherit_id" ref="view_evidence_form"/><field name="arch" type="xml">
<xpath expr="//header/button[@name='action_verify']" position="attributes"><attribute name="groups">supplier_shortage_claim_reconciliation.group_claim_manager,supplier_shortage_claim_reconciliation.group_warehouse_reviewer,supplier_shortage_claim_reconciliation.group_accounts_reviewer</attribute></xpath>
<xpath expr="//header/button[@name='action_reject']" position="attributes"><attribute name="groups">supplier_shortage_claim_reconciliation.group_claim_manager,supplier_shortage_claim_reconciliation.group_warehouse_reviewer,supplier_shortage_claim_reconciliation.group_accounts_reviewer</attribute></xpath>
<xpath expr="//header/button[@name='action_request_more']" position="attributes"><attribute name="groups">supplier_shortage_claim_reconciliation.group_claim_manager,supplier_shortage_claim_reconciliation.group_warehouse_reviewer,supplier_shortage_claim_reconciliation.group_accounts_reviewer</attribute></xpath>
<xpath expr="//header" position="inside"><button name="action_start_evidence_review" type="object" string="Start Evidence Review"/><button name="action_new_revision" type="object" string="Create Corrected Revision"/><field name="effective_state" widget="badge"/></xpath>
<xpath expr="//sheet/group[1]" position="before"><group string="Revision and Scope"><field name="revision_root_id"/><field name="revision_number"/><field name="is_current"/><field name="supersedes_id"/><field name="scope_line_ids" widget="many2many_tags" domain="[('claim_id','=',claim_id)]" readonly="id"/><field name="change_reason" readonly="id"/><field name="reviewer_id"/></group></xpath>
<xpath expr="//field[@name='source_bill_id']" position="after"><field name="source_purchase_line_id" readonly="id"/><field name="source_move_id" readonly="id"/><field name="source_bill_line_id" readonly="id"/><field name="statement" readonly="id"/></xpath>
<xpath expr="//field[@name='verified_at']" position="after"><field name="submitted_by"/><field name="submitted_at"/><field name="is_stale"/><field name="rejection_reason"/><field name="reviewed_fingerprint"/></xpath>
</field></record>
<record id="view_evidence_review_list" model="ir.ui.view"><field name="name">claim.evidence.review.list</field><field name="model">supplier.shortage.claim.evidence</field><field name="arch" type="xml"><list create="0" delete="0" decoration-danger="effective_state == 'rejected'" decoration-warning="effective_state == 'requires_reverification'"><field name="claim_id"/><field name="claim_line_id"/><field name="evidence_type"/><field name="description"/><field name="filename"/><field name="revision_number"/><field name="is_current"/><field name="reviewer_id"/><field name="effective_state" widget="badge"/><field name="verified_by"/><field name="verified_at"/><field name="company_id" groups="base.group_multi_company"/><button name="action_open_document" type="object" string="Document"/></list></field></record>
<record id="view_evidence_review_search" model="ir.ui.view"><field name="name">claim.evidence.review.search</field><field name="model">supplier.shortage.claim.evidence</field><field name="arch" type="xml"><search><field name="claim_id"/><field name="claim_line_id"/><field name="evidence_type"/><field name="reviewer_id"/><field name="company_id" groups="base.group_multi_company"/><filter name="mine" string="Assigned to Me" domain="[('reviewer_id','=',uid)]"/><filter name="new" string="Not Reviewed" domain="[('verification_state','=','not_reviewed'),('is_current','=',True)]"/><filter name="stale" string="Requires Reverification" domain="[('is_stale','=',True),('is_current','=',True)]"/><filter name="rejected" string="Rejected" domain="[('verification_state','=','rejected')]"/><filter name="current" string="Current Revisions" domain="[('is_current','=',True)]"/><group><filter name="claim" string="Claim" context="{'group_by':'claim_id'}"/><filter name="type" string="Evidence Type" context="{'group_by':'evidence_type'}"/><filter name="company" string="Company" context="{'group_by':'company_id'}"/><filter name="reviewer" string="Reviewer" context="{'group_by':'reviewer_id'}"/></group></search></field></record>
<record id="action_evidence_reviews" model="ir.actions.act_window"><field name="name">Evidence Reviews</field><field name="res_model">supplier.shortage.claim.evidence</field><field name="view_mode">list,form</field><field name="view_id" ref="view_evidence_review_list"/><field name="search_view_id" ref="view_evidence_review_search"/><field name="context">{'create':False,'search_default_current':1}</field></record>
<record id="view_evidence_revision_wizard" model="ir.ui.view"><field name="name">evidence.revision.wizard</field><field name="model">supplier.shortage.evidence.revision.wizard</field><field name="arch" type="xml"><form string="Correct Evidence"><group><field name="evidence_id" readonly="1"/><field name="claim_id" invisible="1"/><field name="scope_line_ids" widget="many2many_tags" domain="[('claim_id','=',claim_id)]"/><field name="upload_data" filename="filename"/><field name="filename"/><field name="statement"/><field name="change_reason" required="1"/></group><div class="alert alert-info" role="status">The prior file and verification remain in history. This revision requires a new independent review.</div><footer><button name="action_create_revision" type="object" string="Create Revision" class="btn-primary"/><button special="cancel" string="Cancel"/></footer></form></field></record>
<record id="view_warehouse_observation_form" model="ir.ui.view"><field name="name">warehouse.claim.observation.form</field><field name="model">supplier.shortage.warehouse.observation</field><field name="arch" type="xml"><form delete="0"><header><button name="action_prepare_correction" type="object" string="Record Corrected Observation"/><button name="action_verify" type="object" string="Verify Physical Observation" groups="supplier_shortage_claim_reconciliation.group_warehouse_reviewer"/><button name="action_reject" type="object" string="Reject" groups="supplier_shortage_claim_reconciliation.group_warehouse_reviewer"/><field name="verification_state" widget="statusbar"/></header><sheet><div class="alert alert-info" role="status">Delivery-specific observations are human evidence. They never change native receipts, stock quants, bill quantities or claim allocations. A contradiction requires native-source reconciliation.</div><group><group><field name="claim_line_id" readonly="id"/><field name="claim_id"/><field name="product_id"/><field name="company_id"/><field name="warehouse_id" readonly="id"/><field name="receipt_id" readonly="id"/><field name="location_id" readonly="id"/></group><group><field name="observation_type" readonly="id"/><field name="observed_qty" readonly="id"/><field name="uom_id" readonly="id"/><field name="observed_at" readonly="id"/><field name="recorded_by"/><field name="count_method" readonly="id"/></group></group><field name="explanation" readonly="id"/><field name="evidence_ids" widget="many2many_tags" readonly="id"/><group string="Independent Review"><field name="verification_note"/><field name="verified_by"/><field name="verified_at"/><field name="effective_verified"/><field name="source_conflict"/><field name="indicative_supported_qty"/><field name="is_current"/><field name="supersedes_id"/><field name="correction_reason"/></group></sheet></form></field></record>
<record id="view_claim_readiness" model="ir.ui.view"><field name="name">claim.evidence.readiness</field><field name="model">supplier.shortage.claim</field><field name="inherit_id" ref="view_claim_form"/><field name="arch" type="xml"><xpath expr="//header" position="inside"><button name="action_evaluate_readiness" type="object" string="Evaluate Evidence Readiness" groups="supplier_shortage_claim_reconciliation.group_claim_user"/></xpath><xpath expr="//notebook" position="before"><group string="Evidence Readiness"><field name="evidence_scenario" readonly="state != 'draft'"/><field name="readiness_status" widget="badge"/><field name="readiness_dirty"/><field name="readiness_message"/><field name="readiness_checked_at"/><field name="readiness_access_complete"/><field name="missing_evidence_count" invisible="not readiness_access_complete"/></group></xpath><xpath expr="//notebook" position="inside"><page string="Readiness Checklist"><field name="readiness_checklist"/></page><page string="Warehouse Verification"><field name="warehouse_observation_ids" context="{'default_claim_id':id}"><list create="1" delete="0"><field name="claim_line_id"/><field name="warehouse_id"/><field name="observation_type"/><field name="observed_qty"/><field name="uom_id"/><field name="recorded_by"/><field name="verification_state"/><field name="effective_verified"/><field name="source_conflict"/><field name="indicative_supported_qty"/></list></field></page><page string="Documented Policy Exceptions"><field name="evidence_exception_ids" context="{'default_claim_id':id}"/></page></xpath><xpath expr="//field[@name='claim_line_ids']/list" position="inside"><field name="readiness_status" widget="badge"/><field name="supported_qty" optional="hide"/><field name="readiness_message" optional="hide"/></xpath></field></record>
<record id="view_evidence_requirement_form" model="ir.ui.view"><field name="name">evidence.requirement.form</field><field name="model">supplier.shortage.evidence.requirement</field><field name="arch" type="xml"><form delete="0"><sheet><group><field name="name"/><field name="company_id"/><field name="scenario"/><field name="category"/><field name="allow_exception"/><field name="active"/></group><p>Additional requirements supplement core source, warehouse, accounting and quantity checks. Core checks cannot be waived.</p></sheet></form></field></record>
<record id="view_evidence_exception_form" model="ir.ui.view"><field name="name">evidence.exception.form</field><field name="model">supplier.shortage.evidence.exception</field><field name="arch" type="xml"><form delete="0"><header><button name="action_authorize" type="object" string="Authorize Additional-Document Exception" groups="supplier_shortage_claim_reconciliation.group_claim_manager"/><field name="state" widget="statusbar"/></header><sheet><group><field name="claim_id"/><field name="claim_line_id"/><field name="requirement_id"/><field name="reason"/><field name="reviewed_by"/><field name="reviewed_at"/><field name="source_signature"/></group></sheet></form></field></record>
<record id="action_evidence_requirements" model="ir.actions.act_window"><field name="name">Evidence Requirements</field><field name="res_model">supplier.shortage.evidence.requirement</field><field name="view_mode">list,form</field></record>
<record id="action_missing_evidence" model="ir.actions.act_window"><field name="name">Missing Evidence / Readiness Issues</field><field name="res_model">supplier.shortage.claim</field><field name="view_mode">list,form</field><field name="domain">[('state','=','draft'),('readiness_status','!=','ready')]</field></record>
<menuitem id="menu_evidence_management" name="Evidence Management" parent="menu_recovery_root" sequence="30"/>
<menuitem id="menu_evidence_reviews" name="Evidence Reviews" parent="menu_evidence_management" action="action_evidence_reviews" sequence="10"/>
<menuitem id="menu_missing_evidence" name="Missing Evidence" parent="menu_evidence_management" action="action_missing_evidence" sequence="20" groups="group_claim_user"/>
<menuitem id="menu_evidence_requirements" name="Evidence Requirements" parent="menu_evidence_management" action="action_evidence_requirements" sequence="90" groups="group_module_admin"/>
<record id="view_warehouse_revision_form" model="ir.ui.view"><field name="name">warehouse.observation.correction</field><field name="model">supplier.shortage.warehouse.revision.wizard</field><field name="arch" type="xml"><form string="Correct Warehouse Observation"><group><field name="observation_id" readonly="1"/><field name="observed_qty"/><field name="uom_id"/><field name="count_method"/><field name="explanation"/><field name="change_reason" required="1"/></group><footer><button name="action_create_correction" type="object" string="Create Unreviewed Correction" class="btn-primary"/><button string="Cancel" special="cancel"/></footer></form></field></record>
</odoo>
