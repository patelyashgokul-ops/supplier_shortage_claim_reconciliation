<odoo>
  <record id="view_submission_policy_list" model="ir.ui.view"><field name="name">supplier.shortage.submission.policy.list</field><field name="model">supplier.shortage.submission.policy</field><field name="arch" type="xml"><list><field name="name"/><field name="company_id"/><field name="active"/><field name="max_email_bytes"/><field name="max_files"/><field name="require_supporting_file"/><field name="high_value_finance_required"/></list></field></record>
  <record id="view_submission_policy_form" model="ir.ui.view"><field name="name">supplier.shortage.submission.policy.form</field><field name="model">supplier.shortage.submission.policy</field><field name="arch" type="xml"><form delete="0"><sheet><div class="oe_title"><h1><field name="name"/></h1></div><div class="alert alert-info">Sender and reply address use the configured company email. Native outgoing server settings must support that identity. The stricter company/native MIME limit applies; files are never replaced with public token links.</div><group><group><field name="company_id"/><field name="active"/><field name="template_id" domain="[('model','=','supplier.shortage.claim.submission')]"/><field name="high_value_finance_required"/></group><group><field name="max_email_bytes"/><field name="max_files"/><field name="require_supporting_file"/></group></group><field name="configuration_notes"/></sheet></form></field></record>
  <record id="view_supplier_claim_contact_list" model="ir.ui.view"><field name="name">supplier.shortage.supplier.contact.list</field><field name="model">supplier.shortage.supplier.contact</field><field name="arch" type="xml"><list editable="bottom"><field name="company_id"/><field name="supplier_id"/><field name="contact_id"/></list></field></record>
  <record id="view_submission_list" model="ir.ui.view"><field name="name">supplier.shortage.claim.submission.list</field><field name="model">supplier.shortage.claim.submission</field><field name="arch" type="xml"><list create="0" edit="0" delete="0" decoration-success="state == 'sent'" decoration-danger="state == 'failed'" decoration-muted="superseded or state == 'canceled'">
    <field name="name"/><field name="claim_id"/><field name="supplier_id"/><field name="company_id" groups="base.group_multi_company"/><field name="amount"/><field name="currency_id"/><field name="approval_status" widget="badge"/><field name="revision"/><field name="purpose" optional="hide"/><field name="recipient_email"/><field name="state" widget="badge"/><field name="sent_at"/><field name="last_failure" optional="hide"/><field name="requested_by"/><field name="superseded" optional="hide"/>
  </list></field></record>
  <record id="view_submission_search" model="ir.ui.view"><field name="name">supplier.shortage.claim.submission.search</field><field name="model">supplier.shortage.claim.submission</field><field name="arch" type="xml"><search><field name="claim_id"/><field name="supplier_id"/><field name="recipient_email"/><field name="company_id"/><field name="requested_by"/>
    <filter name="ready" string="Ready" domain="[('state','=','ready')]"/><filter name="queued" string="Queued" domain="[('state','=','queued')]"/><filter name="sent" string="Sent by Infrastructure" domain="[('state','=','sent')]"/><filter name="failed" string="Failed / Needs Review" domain="[('state','=','failed')]"/><filter name="followups" string="Follow-ups" domain="[('purpose','=','followup')]"/><filter name="awaiting" string="No Response Recorded" domain="[('state','=','sent'),('communication_ids.direction','!=','inbound')]"/><filter name="requested" string="Prepared Date" date="requested_at"/>
    <group><filter name="by_company" string="Company" context="{'group_by':'company_id'}"/><filter name="by_state" string="Status" context="{'group_by':'state'}"/><filter name="by_supplier" string="Supplier" context="{'group_by':'supplier_id'}"/></group>
  </search></field></record>
  <record id="view_submission_form" model="ir.ui.view"><field name="name">supplier.shortage.claim.submission.form</field><field name="model">supplier.shortage.claim.submission</field><field name="arch" type="xml"><form create="0" edit="0" delete="0"><header>
    <button name="action_open_composer" type="object" string="Review and Send" class="oe_highlight" invisible="state not in ('draft','ready') or superseded" groups="supplier_shortage_claim_reconciliation.group_external_sender"/>
    <button name="action_open_pdf" type="object" string="Download Preserved PDF" invisible="not pdf_attachment_id"/>
    <button name="action_open_management" type="object" string="Response / Follow-up / Retry" groups="supplier_shortage_claim_reconciliation.group_external_sender"/>
    <field name="state" widget="statusbar" statusbar_visible="draft,ready,queued,sent,failed"/>
  </header><sheet><div class="oe_title"><h1><field name="name"/></h1></div>
    <div class="alert alert-info">Email queued ≠ email sent ≠ email delivered ≠ supplier acceptance. Submission does not record settlement or financial recovery.</div>
    <div class="alert alert-warning" invisible="not superseded">A newer claim submission supersedes this revision. Its original PDF, message and selected evidence remain preserved.</div>
    <div class="alert alert-danger" invisible="not last_failure"><field name="last_failure" nolabel="1"/></div>
    <group><group string="Approved Claim"><field name="claim_id"/><field name="supplier_id"/><field name="company_id"/><field name="approval_id"/><field name="approval_status" widget="badge"/><field name="amount"/><field name="currency_id"/></group><group string="Transmission"><field name="revision"/><field name="purpose"/><field name="previous_id"/><field name="requested_by"/><field name="authorized_by"/><field name="requested_at"/><field name="queued_at"/><field name="sent_at"/><field name="delivery_status"/><field name="retry_count"/></group></group>
    <notebook><page string="Exact Email"><group><field name="recipient_partner_id"/><field name="recipient_email"/><field name="cc_emails"/><field name="sender_email"/><field name="reply_to"/><field name="subject"/></group><field name="body_html" widget="html"/><group><field name="message_reference"/><field name="mail_id" groups="base.group_system"/><field name="revision_reason"/></group></page>
      <page string="Frozen Document Package"><field name="pdf_attachment_id" invisible="True"/><field name="attachment_ids" readonly="1"><list create="0" edit="0" delete="0"><field name="name"/><field name="file_size"/><field name="mimetype"/><field name="checksum" optional="hide"/></list></field><group string="Integrity References"><field name="content_fingerprint"/><field name="package_checksum"/></group><field name="evidence_manifest" readonly="1"/></page>
      <page string="Communication History"><field name="communication_ids" readonly="1"><list create="0" edit="0" delete="0"><field name="communication_date"/><field name="direction"/><field name="kind"/><field name="partner_id"/><field name="recorded_by"/><field name="note"/></list></field></page>
      <page string="Frozen External Statement"><field name="external_snapshot" readonly="1"/></page>
    </notebook>
  </sheet></form></field></record>
  <record id="view_supplier_send_wizard" model="ir.ui.view"><field name="name">supplier.shortage.claim.send.wizard.form</field><field name="model">supplier.shortage.claim.send.wizard</field><field name="arch" type="xml"><form string="Review Supplier Claim Package">
    <div class="alert alert-info">Review recipients, message and every selected file. Preview validates the current approval and freezes the exact PDF/package. Opening or canceling this window sends nothing.</div>
    <group><group string="Claim Summary"><field name="submission_id" readonly="1"/><field name="claim_id"/><field name="supplier_id"/><field name="supplier_commercial_id" invisible="1"/><field name="company_id"/><field name="approval_id"/></group><group string="Approved Value"><field name="amount"/><field name="currency_id"/></group></group>
    <group string="Email Details"><field name="recipient_partner_id" required="1" domain="[('commercial_partner_id','=',supplier_commercial_id),('company_id','in',[False,company_id]),('email','!=',False)]"/><field name="recipient_email" required="1"/><field name="cc_partner_ids" widget="many2many_tags" domain="[('commercial_partner_id','=',supplier_commercial_id),('company_id','in',[False,company_id]),('email','!=',False)]"/><field name="subject"/></group>
    <field name="body_html" widget="html"/>
    <group string="Explicit Supporting File Selection"><field name="evidence_ids" widget="many2many_tags" domain="[('claim_id','=',claim_id),('is_current','=',True),('external_share_approved','=',True),('attachment_id','!=',False)]" options="{'no_create':True}"/></group>
    <group string="Exact Attachments After Preview"><field name="attachment_ids" readonly="1"><list create="0" edit="0" delete="0"><field name="name"/><field name="file_size"/><field name="mimetype"/></list></field></group>
    <field name="preview_fingerprint" invisible="1"/><div class="alert alert-warning" invisible="preview_fingerprint">Preview is required. Changes to the message, recipient or selected evidence require a new preview.</div>
    <field name="confirmed" invisible="not preview_fingerprint"/>
    <footer><button name="action_preview" type="object" string="Preview PDF"/><button name="action_preview_email" type="object" string="Preview Email and Package"/><button name="action_submit_to_supplier" type="object" string="Confirm and Queue Email" class="oe_highlight" invisible="not preview_fingerprint or not confirmed"/><button string="Cancel" special="cancel"/></footer>
  </form></field></record>
  <record id="view_supplier_sharing_wizard" model="ir.ui.view"><field name="name">supplier.shortage.sharing.wizard.form</field><field name="model">supplier.shortage.sharing.wizard</field><field name="arch" type="xml"><form string="External File Disclosure"><div class="alert alert-warning">This approves external sharing of a verified file; it does not send it. Internal financial notes cannot be shared.</div><group><field name="evidence_id" readonly="1"/><field name="approved"/><field name="required"/><field name="reason"/></group><footer><button name="action_apply" type="object" string="Record Disclosure Decision" class="oe_highlight"/><button special="cancel" string="Cancel"/></footer></form></field></record>
  <record id="view_submission_manage_wizard" model="ir.ui.view"><field name="name">supplier.shortage.submission.manage.wizard.form</field><field name="model">supplier.shortage.submission.manage.wizard</field><field name="arch" type="xml"><form string="Supplier Communication Review"><group><field name="submission_id" readonly="1"/><field name="operation"/><field name="response_kind" invisible="operation != 'response'"/><field name="partner_id" invisible="operation != 'response'"/><field name="reason"/><field name="acknowledge_uncertain" invisible="operation != 'retry'"/></group><div class="alert alert-info">Responses are manually verified communication findings. Acknowledgment or disagreement never changes claim acceptance, approved amounts or recovery.</div><footer><button name="action_apply" type="object" string="Confirm Action" class="oe_highlight"/><button special="cancel" string="Cancel"/></footer></form></field></record>
  <record id="view_submission_communication_list" model="ir.ui.view"><field name="name">supplier.shortage.claim.communication.list</field><field name="model">supplier.shortage.claim.communication</field><field name="arch" type="xml"><list create="0" edit="0" delete="0"><field name="claim_id"/><field name="submission_id"/><field name="company_id" groups="base.group_multi_company"/><field name="communication_date"/><field name="direction"/><field name="kind"/><field name="partner_id"/><field name="recorded_by"/><field name="message_reference"/><field name="note"/></list></field></record>
  <record id="view_submission_communication_form" model="ir.ui.view"><field name="name">supplier.shortage.claim.communication.form</field><field name="model">supplier.shortage.claim.communication</field><field name="arch" type="xml"><form create="0" edit="0" delete="0"><sheet><group><field name="claim_id"/><field name="submission_id"/><field name="company_id"/><field name="direction"/><field name="kind"/><field name="partner_id"/><field name="communication_date"/><field name="recorded_by"/><field name="subject"/><field name="message_reference"/></group><field name="note"/></sheet></form></field></record>
  <record id="view_claim_submission_integration" model="ir.ui.view"><field name="name">supplier.shortage.claim.submission.integration</field><field name="model">supplier.shortage.claim</field><field name="inherit_id" ref="view_claim_form"/><field name="arch" type="xml"><xpath expr="//header" position="inside"><button name="action_prepare_supplier_submission" type="object" string="Prepare Supplier Submission" invisible="approval_status != 'approved'" groups="supplier_shortage_claim_reconciliation.group_external_sender"/></xpath><xpath expr="//notebook" position="inside"><page string="Supplier Communication"><div class="alert alert-info">Supplier submission, outgoing processing, delivery and acceptance are different events. History and submitted files are retained.</div><field name="submission_ids" readonly="1"><list create="0" edit="0" delete="0"><field name="name"/><field name="revision"/><field name="recipient_email"/><field name="state" widget="badge"/><field name="queued_at"/><field name="sent_at"/><field name="delivery_status"/><field name="superseded"/></list></field><field name="communication_ids" readonly="1"><list create="0" edit="0" delete="0"><field name="communication_date"/><field name="kind"/><field name="direction"/><field name="note"/></list></field></page></xpath></field></record>
  <record id="view_evidence_external_sharing" model="ir.ui.view"><field name="name">supplier.shortage.evidence.external.sharing</field><field name="model">supplier.shortage.claim.evidence</field><field name="inherit_id" ref="view_evidence_form"/><field name="arch" type="xml"><xpath expr="//sheet" position="inside"><group string="Controlled External Disclosure"><field name="external_share_approved"/><field name="external_share_required"/><field name="external_share_by"/><field name="external_share_at"/><field name="external_share_reason"/><button name="action_open_external_sharing" type="object" string="Review External Sharing" groups="supplier_shortage_claim_reconciliation.group_external_sender"/></group></xpath></field></record>
  <record id="action_supplier_ready" model="ir.actions.act_window"><field name="name">Ready to Submit</field><field name="res_model">supplier.shortage.claim</field><field name="view_mode">list,form</field><field name="domain">[('approval_status','=','approved')]</field></record>
  <record id="action_supplier_submissions" model="ir.actions.act_window"><field name="name">Submission History</field><field name="res_model">supplier.shortage.claim.submission</field><field name="view_mode">list,form</field><field name="help" type="html"><p class="o_view_nocontent_smiling_face">No supplier submission revisions.</p><p>Open an internally approved claim and prepare a supplier submission. Previewing sends nothing.</p></field></record>
  <record id="action_supplier_failures" model="ir.actions.act_window"><field name="name">Failed Emails</field><field name="res_model">supplier.shortage.claim.submission</field><field name="view_mode">list,form</field><field name="domain">[('state','=','failed')]</field></record>
  <record id="action_supplier_responses" model="ir.actions.act_window"><field name="name">Supplier Responses</field><field name="res_model">supplier.shortage.claim.communication</field><field name="view_mode">list,form</field><field name="domain">[('direction','=','inbound')]</field></record>
  <record id="action_supplier_followups" model="ir.actions.act_window"><field name="name">Follow-ups</field><field name="res_model">supplier.shortage.claim.submission</field><field name="view_mode">list,form</field><field name="domain">[('purpose','=','followup')]</field></record>
  <record id="action_submission_policies" model="ir.actions.act_window"><field name="name">Submission Policies</field><field name="res_model">supplier.shortage.submission.policy</field><field name="view_mode">list,form</field></record>
  <record id="action_supplier_claim_contacts" model="ir.actions.act_window"><field name="name">Supplier Claim Contacts</field><field name="res_model">supplier.shortage.supplier.contact</field><field name="view_mode">list,form</field></record>
  <menuitem id="menu_supplier_communication" name="Supplier Communication" parent="menu_recovery_root" sequence="30" groups="group_claim_user,group_accounts_reviewer,group_external_sender,group_module_admin"/>
  <menuitem id="menu_supplier_ready" name="Ready to Submit" parent="menu_supplier_communication" action="action_supplier_ready" sequence="10"/>
  <menuitem id="menu_supplier_submissions" name="Submission History" parent="menu_supplier_communication" action="action_supplier_submissions" sequence="20"/>
  <menuitem id="menu_supplier_failures" name="Failed Emails" parent="menu_supplier_communication" action="action_supplier_failures" sequence="30"/>
  <menuitem id="menu_supplier_responses" name="Supplier Responses" parent="menu_supplier_communication" action="action_supplier_responses" sequence="40"/>
  <menuitem id="menu_supplier_followups" name="Follow-ups" parent="menu_supplier_communication" action="action_supplier_followups" sequence="50"/>
  <menuitem id="menu_submission_policies" name="Submission Policies" parent="menu_supplier_communication" action="action_submission_policies" sequence="60" groups="group_module_admin"/>
  <menuitem id="menu_supplier_claim_contacts" name="Supplier Claim Contacts" parent="menu_supplier_communication" action="action_supplier_claim_contacts" sequence="70" groups="group_module_admin"/>
</odoo>


