<odoo>
    <record id="view_purchase_order_form_shortage_claim" model="ir.ui.view">
        <field name="name">purchase.order.form.shortage.claim</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_shortage_claims" type="object" class="oe_stat_button" icon="fa-files-o"
                        groups="supplier_shortage_claim_reconciliation.group_warehouse_user,supplier_shortage_claim_reconciliation.group_claim_user,supplier_shortage_claim_reconciliation.group_accounts_reviewer,supplier_shortage_claim_reconciliation.group_module_admin">
                    <field name="shortage_claim_count" widget="statinfo" string="Shortage Claims"/>
                </button>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="action_create_shortage_claim" type="object" string="Create Shortage Claim"
                        groups="supplier_shortage_claim_reconciliation.group_claim_user"/>
            </xpath>
        </field>
    </record>
</odoo>
