<odoo>
<record id="view_detection_list" model="ir.ui.view"><field name="name">shortage.detection.list</field><field name="model">supplier.shortage.receipt.exception</field><field name="arch" type="xml">
<list create="0" delete="0" decoration-danger="priority == 'high'" decoration-muted="classification == 'reconciled'">
<field name="name"/><field name="partner_id"/><field name="purchase_id"/><field name="product_id"/><field name="company_id" groups="base.group_multi_company"/><field name="evidence_complete"/><field name="ordered_qty"/><field name="net_received_qty"/><field name="posted_billed_qty"/><field name="potential_billed_excess_qty"/><field name="physical_difference_qty" optional="hide"/><field name="candidate_qty"/><field name="currency_id" column_invisible="True"/><field name="indicative_untaxed_exposure"/><field name="valuation_status"/><field name="classification"/><field name="priority" widget="badge"/><field name="assigned_user_id"/><field name="review_state" widget="badge"/>
</list></field></record>
<record id="view_detection_search" model="ir.ui.view"><field name="name">shortage.detection.search</field><field name="model">supplier.shortage.receipt.exception</field><field name="arch" type="xml"><search>
<field name="partner_id"/><field name="company_id" groups="base.group_multi_company"/><field name="purchase_id"/><field name="classification"/><field name="assigned_user_id"/><field name="review_state"/>
<filter name="mine" string="My Reviews" domain="[('assigned_user_id','=',uid)]"/><filter name="new" string="New Candidates" domain="[('review_state','=','new')]"/><filter name="pending" string="Pending Delivery" domain="[('classification','=','pending_supplier_delivery')]"/><filter name="billed" string="Posted Billing Excess" domain="[('potential_billed_excess_qty','&gt;',0)]"/><filter name="high" string="High Priority" domain="[('priority','in',['high','critical'])]"/><filter name="conflict" string="Source Conflicts" domain="[('evidence_complete','=',False)]"/><filter name="over" string="Over-Receipts" domain="[('classification','=','over_receipt')]"/><filter name="overlap" string="Existing Claim Overlap" domain="[('claim_overlap','=',True)]"/>
<group><filter name="supplier" string="Supplier" context="{'group_by':'partner_id'}"/><filter name="priority" string="Priority" context="{'group_by':'priority'}"/><filter name="company" string="Company" context="{'group_by':'company_id'}"/><filter name="category" string="Category" context="{'group_by':'classification'}"/><filter name="employee" string="Responsible Employee" context="{'group_by':'assigned_user_id'}"/></group>
</search></field></record>
<record id="view_detection_form" model="ir.ui.view"><field name="name">shortage.detection.form</field><field name="model">supplier.shortage.receipt.exception</field><field name="arch" type="xml"><form create="0" delete="0"><header>
<button name="action_run_detection" type="object" string="Refresh Detection" groups="supplier_shortage_claim_reconciliation.group_claim_user"/>
<button name="action_start_review" type="object" string="Start Review" invisible="review_state != 'new'"/>
<button name="action_verify_candidate" type="object" string="Verify Candidate Evidence" invisible="classification != 'shortage_candidate_review' or review_state not in ('new','in_review')" groups="supplier_shortage_claim_reconciliation.group_claim_manager"/>
<button name="action_dismiss" type="object" string="Clear Finding" invisible="review_state not in ('new','in_review')" groups="supplier_shortage_claim_reconciliation.group_claim_manager"/>
<button name="action_reopen" type="object" string="Reopen" invisible="review_state not in ('resolved','dismissed')" groups="supplier_shortage_claim_reconciliation.group_claim_manager"/>
<field name="review_state" widget="statusbar"/></header><sheet><div class="alert alert-info">Detection candidates are NOT approved supplier claims. Indicative untaxed exposure is NOT verified recovery. Resolved means evidence review completed.</div><h1><field name="name"/></h1>
<group><group string="Purchase Information"><field name="purchase_id"/><field name="purchase_line_id"/><field name="partner_id"/><field name="product_id"/><field name="product_uom_id"/><field name="company_id"/><field name="ordered_qty"/></group><group string="Detection Findings"><field name="classification"/><field name="evidence_complete"/><field name="priority"/><field name="priority_reason"/><field name="candidate_qty"/><field name="last_detected_at"/><field name="next_action"/></group></group>
<notebook><page string="Receiving Reconciliation"><group><field name="gross_received_qty"/><field name="returned_qty"/><field name="net_received_qty"/><field name="pending_qty"/><field name="pending_backorder_qty"/><field name="physical_difference_qty"/></group><button name="action_open_sources" type="object" string="Open Receipt Evidence"/><field name="source_move_ids" readonly="1"/></page>
<page string="Vendor Billing"><group><field name="posted_billed_qty"/><field name="draft_billed_qty"/><field name="posted_credit_qty"/><field name="potential_billed_excess_qty"/></group><button name="action_open_billing_sources" type="object" string="Open Billing Evidence"/><field name="source_bill_line_ids" readonly="1"/></page>
<page string="Financial Exposure"><group><field name="currency_id"/><field name="valuation_status"/><field name="indicative_untaxed_exposure"/><field name="claim_overlap"/><field name="related_claim_ids" widget="many2many_tags"/></group></page>
<page string="Evidence and Review"><field name="description"/><field name="findings_summary"/><group><field name="assigned_user_id"/><field name="review_reason"/><field name="source_signature"/></group></page>
<page string="Audit History"><field name="audit_event_ids" readonly="1"/></page></notebook></sheet></form></field></record>
<record id="action_detection" model="ir.actions.act_window"><field name="name">Detection Candidates</field><field name="res_model">supplier.shortage.receipt.exception</field><field name="view_mode">list,form</field><field name="view_id" ref="view_detection_list"/><field name="search_view_id" ref="view_detection_search"/><field name="domain">[('reconciliation_kind','=','detection')]</field><field name="context">{'create':False}</field></record>
<record id="action_detection_list" model="ir.actions.act_window.view"><field name="sequence">1</field><field name="view_mode">list</field><field name="view_id" ref="view_detection_list"/><field name="act_window_id" ref="action_detection"/></record>
<record id="action_detection_form" model="ir.actions.act_window.view"><field name="sequence">2</field><field name="view_mode">form</field><field name="view_id" ref="view_detection_form"/><field name="act_window_id" ref="action_detection"/></record>
<menuitem id="menu_detection" name="Shortage Detection" parent="menu_recovery_root" sequence="20" groups="group_claim_user"/><menuitem id="menu_detection_candidates" name="Detection Candidates" parent="menu_detection" action="action_detection"/>
<record id="action_detection_queue" model="ir.actions.act_window"><field name="name">Detection Review Queue</field><field name="res_model">supplier.shortage.receipt.exception</field><field name="view_mode">list,form</field><field name="view_id" ref="view_detection_list"/><field name="search_view_id" ref="view_detection_search"/><field name="domain">[('reconciliation_kind','=','detection'),('classification','!=','reconciled'),('review_state','in',['new','in_review'])]</field><field name="context">{'create':False}</field></record>
<record id="action_detection_queue_list" model="ir.actions.act_window.view"><field name="sequence">1</field><field name="view_mode">list</field><field name="view_id" ref="view_detection_list"/><field name="act_window_id" ref="action_detection_queue"/></record>
<record id="action_detection_queue_form" model="ir.actions.act_window.view"><field name="sequence">2</field><field name="view_mode">form</field><field name="view_id" ref="view_detection_form"/><field name="act_window_id" ref="action_detection_queue"/></record>
<menuitem id="menu_detection_queue" name="Review Queue" parent="menu_detection" action="action_detection_queue" sequence="20"/>
<record id="action_detection_batch" model="ir.actions.server"><field name="name">Refresh Selected Detection Reviews</field><field name="model_id" ref="model_supplier_shortage_receipt_exception"/><field name="binding_model_id" ref="model_supplier_shortage_receipt_exception"/><field name="state">code</field><field name="code">action = records.action_run_detection()</field><field name="group_ids" eval="[(4, ref('group_claim_user'))]"/></record>
<record id="action_detection_po_lines" model="ir.actions.server"><field name="name">Run Shortage Detection</field><field name="model_id" ref="purchase.model_purchase_order_line"/><field name="binding_model_id" ref="purchase.model_purchase_order_line"/><field name="state">code</field><field name="code">action = records.action_run_shortage_detection()</field><field name="group_ids" eval="[(4, ref('group_claim_user'))]"/></record>
<record id="view_purchase_detection" model="ir.ui.view"><field name="name">purchase.shortage.detection</field><field name="model">purchase.order</field><field name="inherit_id" ref="purchase.purchase_order_form"/><field name="arch" type="xml"><xpath expr="//header" position="inside"><button name="action_run_shortage_detection" type="object" string="Run Shortage Detection" groups="supplier_shortage_claim_reconciliation.group_claim_user"/></xpath></field></record>
<record id="view_detection_company_thresholds" model="ir.ui.view"><field name="name">company.shortage.detection.thresholds</field><field name="model">res.company</field><field name="inherit_id" ref="base.view_company_form"/><field name="arch" type="xml"><xpath expr="//notebook" position="inside"><page string="Shortage Review Priority"><group><field name="ssc_detection_high_threshold"/><field name="ssc_detection_critical_threshold"/></group><p>Thresholds use company currency and apply only to reliable indicative exposure in that currency. Zero disables the threshold.</p></page></xpath></field></record>
</odoo>
