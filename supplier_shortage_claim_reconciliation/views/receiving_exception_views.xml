<odoo>
    <record id="view_receiving_exception_list" model="ir.ui.view">
        <field name="name">supplier.shortage.receipt.exception.list</field><field name="model">supplier.shortage.receipt.exception</field>
        <field name="arch" type="xml"><list create="0" delete="0" decoration-muted="not condition_present">
            <field name="name"/><field name="partner_id"/><field name="purchase_id"/><field name="purchase_line_id"/><field name="product_id" optional="hide"/>
            <field name="company_id" groups="base.group_multi_company"/><field name="exception_type"/>
            <field name="quantity_known" column_invisible="True"/><field name="affected_quantity" invisible="not quantity_known"/><field name="product_uom_id"/>
            <field name="severity" widget="badge"/><field name="assigned_user_id"/><field name="review_state" widget="badge"/><field name="condition_present" optional="hide"/><field name="last_detected_at"/>
        </list></field>
    </record>
    <record id="view_receiving_exception_search" model="ir.ui.view">
        <field name="name">supplier.shortage.receipt.exception.search</field><field name="model">supplier.shortage.receipt.exception</field>
        <field name="arch" type="xml"><search>
            <field name="name"/><field name="partner_id"/><field name="purchase_id"/><field name="purchase_line_id"/><field name="assigned_user_id"/><field name="company_id" groups="base.group_multi_company"/>
            <filter name="mine" string="My Exceptions" domain="[('assigned_user_id','=',uid)]"/>
            <filter name="present" string="Current Conditions" domain="[('condition_present','=',True)]"/>
            <filter name="new" string="New" domain="[('review_state','=','new')]"/><filter name="in_review" string="In Review" domain="[('review_state','=','in_review')]"/>
            <filter name="high" string="High Priority" domain="[('severity','=','high')]"/>
            <filter name="canceled" string="Canceled Backorders" domain="[('exception_type','=','canceled_backorder_review')]"/>
            <filter name="over" string="Over-Receipts" domain="[('exception_type','=','over_receipt')]"/>
            <filter name="mismatch" string="Source Mismatches" domain="[('exception_type','=','source_quantity_mismatch')]"/>
            <group><filter name="by_type" string="Exception Type" context="{'group_by':'exception_type'}"/><filter name="by_supplier" string="Supplier" context="{'group_by':'partner_id'}"/>
            <filter name="by_owner" string="Assigned Employee" context="{'group_by':'assigned_user_id'}"/><filter name="by_state" string="Review State" context="{'group_by':'review_state'}"/></group>
        </search></field>
    </record>
    <record id="view_receiving_exception_form" model="ir.ui.view">
        <field name="name">supplier.shortage.receipt.exception.form</field><field name="model">supplier.shortage.receipt.exception</field>
        <field name="arch" type="xml"><form create="0" delete="0">
            <header>
                <button name="action_start_review" type="object" string="Start Review" invisible="review_state != 'new'" groups="group_claim_user,group_warehouse_user" class="oe_highlight"/>
                <button name="action_resolve" type="object" string="Resolve Review" invisible="review_state not in ['new','in_review']" groups="group_claim_manager"/>
                <button name="action_dismiss" type="object" string="Dismiss with Reason" invisible="review_state not in ['new','in_review']" groups="group_claim_manager"/>
                <button name="action_reopen" type="object" string="Reopen Review" invisible="review_state not in ['resolved','dismissed']" groups="group_claim_manager"/>
                <button name="action_open_sources" type="object" string="Open Source Movements"/>
                <field name="review_state" widget="statusbar"/><field name="can_manage_review" invisible="True"/>
            </header>
            <sheet>
                <div class="alert alert-info" role="status">Receiving review only. An exception does not establish supplier fault, confirmed shortage or financial recovery.</div>
                <div class="oe_title"><h1><field name="name"/></h1></div>
                <group><group><field name="purchase_id"/><field name="purchase_line_id"/><field name="partner_id"/><field name="product_id"/><field name="company_id"/></group>
                <group><field name="exception_type"/><field name="severity"/><field name="condition_present"/><field name="assigned_user_id" readonly="review_state not in ['new','in_review']" groups="group_claim_manager"/>
                <field name="quantity_known"/><field name="affected_quantity" invisible="not quantity_known"/><field name="product_uom_id"/><field name="claim_id" invisible="not claim_id"/></group></group>
                <group string="Source Finding"><field name="description" nolabel="1"/><field name="first_detected_at"/><field name="last_detected_at"/></group>
                <group string="Human Review"><field name="review_reason" readonly="review_state not in ['new','in_review'] and not can_manage_review" placeholder="Record the evidence checked and a meaningful decision reason."/><field name="resolved_by"/><field name="resolved_at"/><field name="last_decision_reason"/></group>
                <notebook><page string="Review History"><field name="audit_event_ids" readonly="1"><list create="0" edit="0" delete="0">
                    <field name="event_datetime"/><field name="actor_id"/><field name="event_type"/><field name="change_summary"/><field name="reason"/>
                </list></field></page></notebook>
            </sheet>
        </form></field>
    </record>
    <record id="action_receiving_exceptions" model="ir.actions.act_window">
        <field name="name">Receiving Exceptions</field><field name="res_model">supplier.shortage.receipt.exception</field><field name="view_mode">list,form</field>
        <field name="context">{'search_default_present': 1}</field>
    </record>
    <record id="action_backorder_reviews" model="ir.actions.act_window">
        <field name="name">Backorder Reviews</field><field name="res_model">supplier.shortage.receipt.exception</field><field name="view_mode">list,form</field>
        <field name="domain">[('exception_type','in',['pending_delivery','canceled_backorder_review','inconsistent_backorder'])]</field>
        <field name="context">{'search_default_present': 1}</field>
    </record>
    <menuitem id="menu_receiving_reconciliation" name="Receiving Reconciliation" parent="menu_recovery_root" sequence="20"/>
    <menuitem id="menu_receiving_exceptions" name="Receiving Exceptions" parent="menu_receiving_reconciliation" action="action_receiving_exceptions" sequence="10"/>
    <menuitem id="menu_backorder_reviews" name="Backorder Reviews" parent="menu_receiving_reconciliation" action="action_backorder_reviews" sequence="20"/>
    <record id="view_claim_receiving_integrity" model="ir.ui.view">
        <field name="name">supplier.shortage.claim.receiving.integrity</field><field name="model">supplier.shortage.claim</field><field name="inherit_id" ref="view_claim_receiving_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside"><button name="action_reconcile_receiving" type="object" string="Refresh Receiving Review" groups="group_claim_user" invisible="not purchase_id"/></xpath>
            <xpath expr="//notebook" position="inside"><page string="Receiving Integrity Summary">
                <div class="alert alert-info" role="status">Unreceived difference uses net supplier receipts. Pending and canceled demand can overlap this difference and must not be added to derive a claim amount.</div>
                <group><field name="receiving_reconciled_at"/><field name="receiving_exception_count" invisible="not receiving_accessible"/></group>
                <field name="receiving_integrity_summary" nolabel="1"/>
                <button name="action_view_receiving_exceptions" type="object" string="Open Receiving Exceptions"/>
                <field name="receiving_exception_ids" readonly="1"><list create="0" edit="0" delete="0">
                    <field name="exception_type"/><field name="purchase_line_id"/><field name="severity"/><field name="assigned_user_id"/><field name="review_state"/><field name="condition_present"/><field name="last_detected_at"/>
                </list></field>
            </page></xpath>
            <xpath expr="//field[@name='receipt_unreceived_qty']/.." position="inside">
                <field name="receipt_delivery_difference_qty" invisible="not receiving_complete"/><field name="receipt_over_received_qty" invisible="not receiving_complete"/>
                <field name="receipt_canceled_demand_qty" invisible="not receiving_complete"/><field name="receiving_integrity_note"/>
            </xpath>
        </field>
    </record>
</odoo>
