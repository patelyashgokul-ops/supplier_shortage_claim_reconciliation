<menuitem id="menu_supplier_commitments" name="Supplier Commitments" parent="menu_supplier_response_workbench" action="action_supplier_commitments" sequence="70"/>
<record id="view_supplier_response_evidence" model="ir.ui.view"><field name="name">supplier.response.evidence</field><field name="model">supplier.shortage.claim.evidence</field><field name="inherit_id" ref="view_evidence_form"/><field name="arch" type="xml"><xpath expr="//field[@name='claim_id']" position="after"><field name="supplier_response_submission_id" readonly="id" domain="[('claim_id','=',claim_id),('state','=','sent')]"/></xpath><xpath expr="//header" position="inside"><button name="action_flag_claim_contradiction" type="object" string="Flag Contradictory Supplier Evidence" invisible="not supplier_response_submission_id" groups="supplier_shortage_claim_reconciliation.group_claim_manager,supplier_shortage_claim_reconciliation.group_finance_manager"/></xpath></field></record>
<record id="action_supplier_response_evidence" model="ir.actions.act_window"><field name="name">Supplier Response Documents</field><field name="res_model">supplier.shortage.claim.evidence</field><field name="view_mode">list,form</field><field name="domain">[('supplier_response_submission_id','!=',False)]</field><field name="context">{'default_evidence_type':'supplier_response'}</field></record>
<record id="action_supplier_response_reasons" model="ir.actions.act_window"><field name="name">Supplier Rejection Reasons</field><field name="res_model">supplier.shortage.response.reason</field><field name="view_mode">list,form</field></record>
<menuitem id="menu_supplier_response_documents" name="Supplier Evidence" parent="menu_supplier_response_workbench" action="action_supplier_response_evidence" sequence="80"/>
<menuitem id="menu_supplier_response_reasons" name="Supplier Rejection Reasons" parent="menu_recovery_root" action="action_supplier_response_reasons" sequence="90" groups="supplier_shortage_claim_reconciliation.group_module_admin"/>
<record id="action_supplier_awaiting_reply" model="ir.actions.act_window"><field name="name">Awaiting Supplier Reply</field><field name="res_model">supplier.shortage.claim.submission</field><field name="view_mode">list,form</field><field name="domain">[('state','=','sent'),('superseded','=',False),('communication_ids.direction','!=','inbound')]</field></record>
