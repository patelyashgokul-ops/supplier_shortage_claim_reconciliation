<menuitem id="menu_supplier_partial" name="Partial Acceptances" parent="menu_supplier_response_workbench" action="action_partial_supplier_responses" sequence="30"/>
<menuitem id="menu_supplier_rejected" name="Rejected Positions" parent="menu_supplier_response_workbench" action="action_rejected_supplier_responses" sequence="40"/>
<menuitem id="menu_supplier_disputes" name="Dispute Cases" parent="menu_supplier_response_workbench" action="action_supplier_disputes" sequence="50"/>
