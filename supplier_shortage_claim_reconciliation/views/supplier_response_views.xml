<odoo>
<record id="view_supplier_response_list" model="ir.ui.view"><field name="name">supplier.response.list</field><field name="model">supplier.shortage.claim.response</field><field name="arch" type="xml"><list decoration-success="verification_state == 'verified'" decoration-warning="verification_state in ('unverified','review')" decoration-muted="verification_state in ('superseded','invalid')"><field name="claim_id"/><field name="supplier_id"/><field name="revision"/><field name="response_type"/><field name="response_date"/><field name="verification_state" widget="badge"/><field name="approved_amount"/><field name="accepted_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/><field name="rejected_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/><field name="disputed_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/><field name="pending_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/><field name="financial_review_required"/><field name="currency_id" column_invisible="True"/><field name="verified_by"/><field name="company_id" groups="base.group_multi_company"/></list></field></record>
<record id="view_supplier_response_search" model="ir.ui.view"><field name="name">supplier.response.search</field><field name="model">supplier.shortage.claim.response</field><field name="arch" type="xml"><search><field name="claim_id"/><field name="supplier_id"/><field name="submission_id" domain="[('state','=','sent')]"/><filter name="pending" string="Pending Verification" domain="[('verification_state','in',['unverified','review'])]"/><filter name="current" string="Current Decisions" domain="[('current_key','!=',False)]"/><filter name="accepted" string="Full Acceptance" domain="[('position_kind','=','accepted'),('verification_state','=','verified')]"/><filter name="partial" string="Partial Acceptance" domain="[('position_kind','=','partial'),('verification_state','=','verified')]"/><filter name="rejected" string="Rejection" domain="[('response_type','=','rejection')]"/><filter name="evidence" string="Awaiting Evidence" domain="[('response_type','=','evidence')]"/><filter name="date" string="Response Date" date="response_date"/><group><filter name="supplier" string="Supplier" context="{'group_by':'supplier_id'}"/><filter name="company" string="Company" context="{'group_by':'company_id'}"/><filter name="state" string="Verification" context="{'group_by':'verification_state'}"/></group></search></field></record>
<record id="view_supplier_response_form" model="ir.ui.view"><field name="name">supplier.response.form</field><field name="model">supplier.shortage.claim.response</field><field name="arch" type="xml"><form string="Supplier Response" duplicate="false" delete="false"><header><button name="action_verify" type="object" string="Verify Decision" class="oe_highlight" invisible="verification_state not in ('unverified','review')" groups="supplier_shortage_claim_reconciliation.group_claim_manager,supplier_shortage_claim_reconciliation.group_finance_manager"/><button name="action_require_review" type="object" string="Require Review" invisible="verification_state != 'unverified'" groups="supplier_shortage_claim_reconciliation.group_claim_manager,supplier_shortage_claim_reconciliation.group_finance_manager"/><button name="action_invalidate" type="object" string="Reject as Invalid" invisible="verification_state not in ('unverified','review')" groups="supplier_shortage_claim_reconciliation.group_claim_manager,supplier_shortage_claim_reconciliation.group_finance_manager"/><field name="verification_state" widget="statusbar"/></header><sheet><div class="alert alert-info" role="alert">Supplier Accepted ≠ Financially Recovered. This form records evidence and supplier positions; it does not execute settlement.</div><div class="alert alert-warning" role="alert" invisible="not financial_review_required">Financial review required: source-proportional values do not reconcile when rounded for currency display. No balancing amount or settlement is created.</div><group string="Submitted Claim"><group><field name="submission_id" readonly="id" domain="[('state','=','sent')]"/><field name="claim_id"/><field name="supplier_id"/><field name="company_id" groups="base.group_multi_company"/></group><group><field name="revision"/><field name="approved_amount"/><field name="currency_id"/><field name="current_key" invisible="True"/></group></group><group string="Supplier Decision"><group><field name="response_type" readonly="id"/><field name="response_source" readonly="id"/><field name="response_date" readonly="id"/><field name="supplier_contact_id" readonly="id"/></group><group><field name="response_reference" readonly="id"/><field name="source_message_id" readonly="id"/><field name="communication_id"/><field name="evidence_ids" widget="many2many_tags" readonly="id"/></group></group><field name="response_summary" placeholder="Record actual supplier intent, source, contact and scope of the discussion." readonly="id"/><notebook><page string="Line Positions"><field name="line_ids" readonly="id or not submission_id"><list editable="bottom" delete="true"><field name="claim_line_id" domain="[('claim_id','=',parent.claim_id)]"/><field name="product_id"/><field name="purchase_line_id" optional="hide"/><field name="submitted_qty"/><field name="product_uom_id"/><field name="accepted_qty"/><field name="rejected_qty"/><field name="disputed_qty"/><field name="pending_qty"/><field name="accepted_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/><field name="rejected_amount" optional="hide" widget="monetary" options="{'currency_field': 'currency_id'}"/><field name="disputed_amount" optional="hide" widget="monetary" options="{'currency_field': 'currency_id'}"/><field name="currency_id" column_invisible="True"/><field name="rejection_reason_id"/><field name="decision_reason"/></list></field><group><field name="accepted_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/><field name="rejected_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/><field name="disputed_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/><field name="pending_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/><field name="financial_review_required"/></group><div class="text-muted">Values use the frozen submitted untaxed basis. Currency rounding differences require Accounts review; no balancing amount is invented. Record alternative prices, currencies and tax terms as negotiation events. Omitted lines and quantities remain pending.</div></page><page string="Verification &amp; Provenance"><field name="verification_note" readonly="not id or verification_state not in ('unverified','review')"/><group><field name="reported_by"/><field name="reported_at"/><field name="verified_by"/><field name="verified_at"/><field name="superseded_by_id"/><field name="source_key"/></group></page></notebook></sheet></form></field></record>
<record id="action_supplier_decisions" model="ir.actions.act_window"><field name="name">Supplier Responses</field><field name="res_model">supplier.shortage.claim.response</field><field name="view_mode">list,form</field></record>
<record id="action_pending_supplier_responses" model="ir.actions.act_window"><field name="name">Pending Response Verification</field><field name="res_model">supplier.shortage.claim.response</field><field name="view_mode">list,form</field><field name="domain">[('verification_state','in',['unverified','review'])]</field></record>
<record id="action_partial_supplier_responses" model="ir.actions.act_window"><field name="name">Partial Acceptances</field><field name="res_model">supplier.shortage.claim.response</field><field name="view_mode">list,form</field><field name="domain">[('position_kind','=','partial'),('verification_state','=','verified')]</field></record>
<record id="action_rejected_supplier_responses" model="ir.actions.act_window"><field name="name">Supplier Rejections</field><field name="res_model">supplier.shortage.claim.response</field><field name="view_mode">list,form</field><field name="domain">[('response_type','=','rejection')]</field></record>
<record id="view_supplier_negotiation_list" model="ir.ui.view"><field name="name">supplier.negotiation.list</field><field name="model">supplier.shortage.claim.negotiation</field><field name="arch" type="xml"><list><field name="claim_id"/><field name="supplier_id"/><field name="revision"/><field name="negotiation_type"/><field name="proposed_amount"/><field name="currency_id"/><field name="tax_basis"/><field name="status" widget="badge"/><field name="financial_review_required"/><field name="event_date"/><field name="recorded_by"/><field name="company_id" groups="base.group_multi_company"/></list></field></record>
<record id="view_supplier_negotiation_form" model="ir.ui.view"><field name="name">supplier.negotiation.form</field><field name="model">supplier.shortage.claim.negotiation</field><field name="arch" type="xml"><form duplicate="false" delete="false"><header><button name="action_accounts_review" type="object" string="Accounts Review" invisible="status != 'proposed'" groups="supplier_shortage_claim_reconciliation.group_accounts_reviewer"/><button name="action_authorize" type="object" string="Authorize Proposal" invisible="status != 'accounts'" groups="supplier_shortage_claim_reconciliation.group_finance_manager"/><button name="action_decline" type="object" string="Decline" invisible="status not in ('proposed','accounts')" groups="supplier_shortage_claim_reconciliation.group_claim_manager,supplier_shortage_claim_reconciliation.group_finance_manager"/><field name="status" widget="statusbar"/></header><sheet><div class="alert alert-info" role="alert">Negotiation offers and internal authorization do not change the approved claim, supplier acceptance or financial recovery.</div><group><group><field name="submission_id" readonly="id" domain="[('state','=','sent')]"/><field name="claim_id"/><field name="supplier_id"/><field name="response_id" readonly="id"/><field name="negotiation_type" readonly="id"/><field name="supersedes_event_id" readonly="id"/></group><group><field name="proposed_amount" readonly="id"/><field name="currency_id" readonly="id"/><field name="tax_basis" readonly="id"/><field name="financial_review_required"/><field name="company_id" groups="base.group_multi_company"/></group></group><field name="claim_line_ids" widget="many2many_tags" readonly="id"/><field name="description" readonly="id"/><field name="evidence_ids" widget="many2many_tags" readonly="id"/><group string="Internal Review"><field name="decision_note" readonly="not id or status not in ('proposed','accounts')"/><field name="accounts_by"/><field name="decided_by"/><field name="decided_at"/></group><group><field name="recorded_by"/><field name="event_date"/></group></sheet></form></field></record>
<record id="action_supplier_negotiations" model="ir.actions.act_window"><field name="name">Negotiation History</field><field name="res_model">supplier.shortage.claim.negotiation</field><field name="view_mode">list,form</field></record>
<record id="view_supplier_commitment_list" model="ir.ui.view"><field name="name">supplier.commitment.list</field><field name="model">supplier.shortage.claim.commitment</field><field name="arch" type="xml"><list decoration-danger="overdue"><field name="claim_id"/><field name="supplier_id"/><field name="commitment_type"/><field name="committed_amount"/><field name="currency_id"/><field name="committed_qty"/><field name="product_uom_id"/><field name="promised_date"/><field name="overdue"/><field name="responsible_id"/><field name="status" widget="badge"/><field name="company_id" groups="base.group_multi_company"/></list></field></record>
<record id="view_supplier_commitment_form" model="ir.ui.view"><field name="name">supplier.commitment.form</field><field name="model">supplier.shortage.claim.commitment</field><field name="arch" type="xml"><form duplicate="false" delete="false"><header><button name="action_pending_verification" type="object" string="Fulfilled - Pending Verification" invisible="status != 'promised'" groups="supplier_shortage_claim_reconciliation.group_claim_manager,supplier_shortage_claim_reconciliation.group_finance_manager"/><button name="action_cancel" type="object" string="Cancel Promise" invisible="status not in ('promised','pending')" groups="supplier_shortage_claim_reconciliation.group_claim_manager,supplier_shortage_claim_reconciliation.group_finance_manager"/><field name="status" widget="statusbar"/></header><sheet><div class="alert alert-warning" role="alert">Supplier Promise ≠ Verified Settlement. An overdue date or reported fulfillment never records recovery.</div><group><group><field name="submission_id" readonly="id" domain="[('state','=','sent')]"/><field name="claim_id"/><field name="supplier_id"/><field name="response_id" readonly="id"/><field name="commitment_type" readonly="id"/><field name="supersedes_id" readonly="id"/></group><group><field name="committed_amount" readonly="id"/><field name="currency_id" readonly="id"/><field name="claim_line_id" readonly="id"/><field name="committed_qty" readonly="id"/><field name="product_uom_id" readonly="id"/><field name="promised_date" readonly="id"/><field name="responsible_id" readonly="id"/><field name="overdue"/><field name="company_id" groups="base.group_multi_company"/></group></group><field name="description" readonly="id"/><field name="evidence_ids" widget="many2many_tags" readonly="id"/><field name="status_note" readonly="not id or status not in ('promised','pending')"/><group><field name="recorded_by"/><field name="event_date"/></group></sheet></form></field></record>
<record id="view_supplier_commitment_search" model="ir.ui.view"><field name="name">supplier.commitment.search</field><field name="model">supplier.shortage.claim.commitment</field><field name="arch" type="xml"><search><field name="claim_id"/><field name="supplier_id"/><filter name="overdue" string="Overdue Promises" domain="[('status','=','promised'),('promised_date','&lt;',context_today().strftime('%Y-%m-%d'))]"/><filter name="pending" string="Awaiting Settlement Verification" domain="[('status','=','pending')]"/></search></field></record>
<record id="action_supplier_commitments" model="ir.actions.act_window"><field name="name">Supplier Commitments</field><field name="res_model">supplier.shortage.claim.commitment</field><field name="view_mode">list,form</field></record>
<record id="view_supplier_dispute_list" model="ir.ui.view"><field name="name">supplier.dispute.list</field><field name="model">supplier.shortage.claim.dispute</field><field name="arch" type="xml"><list decoration-danger="overdue" decoration-muted="dispute_state == 'closed'"><field name="priority" widget="priority"/><field name="issue_reference"/><field name="claim_id"/><field name="supplier_id"/><field name="claim_line_id"/><field name="dispute_state" widget="badge"/><field name="assigned_user_id"/><field name="next_action"/><field name="next_action_date"/><field name="contractual_deadline"/><field name="overdue"/><field name="company_id" groups="base.group_multi_company"/></list></field></record>
<record id="view_supplier_dispute_search" model="ir.ui.view"><field name="name">supplier.dispute.search</field><field name="model">supplier.shortage.claim.dispute</field><field name="arch" type="xml"><search><field name="claim_id"/><field name="supplier_id"/><field name="issue_reference"/><filter name="mine" string="My Disputes" domain="[('assigned_user_id','=',uid)]"/><filter name="open" string="Open Disputes" domain="[('dispute_state','not in',['resolved','closed'])]"/><filter name="negotiating" string="Under Negotiation" domain="[('dispute_state','=','negotiating')]"/><filter name="evidence" string="Awaiting Evidence" domain="[('dispute_state','=','evidence')]"/><filter name="overdue" string="Overdue Internal Follow-up" domain="[('next_action_date','&lt;',context_today().strftime('%Y-%m-%d')),('dispute_state','not in',['resolved','closed'])]"/><filter name="urgent" string="Urgent" domain="[('priority','=','2')]"/><group><filter name="company" string="Company" context="{'group_by':'company_id'}"/><filter name="supplier" string="Supplier" context="{'group_by':'supplier_id'}"/><filter name="state" string="Case State" context="{'group_by':'dispute_state'}"/></group></search></field></record>
<record id="view_supplier_dispute_form" model="ir.ui.view"><field name="name">supplier.dispute.form</field><field name="model">supplier.shortage.claim.dispute</field><field name="arch" type="xml"><form duplicate="false" delete="false"><header><button name="action_request_evidence" type="object" string="Request Evidence" invisible="dispute_state in ('evidence','resolved','closed')"/><button name="action_investigate" type="object" string="Investigate / Reopen Review" invisible="dispute_state in ('investigation','closed')"/><button name="action_negotiate" type="object" string="Negotiate" invisible="dispute_state in ('negotiating','evidence','resolved','closed')"/><button name="action_await_supplier" type="object" string="Await Supplier" invisible="dispute_state in ('supplier','resolved','closed')"/><button name="action_escalate" type="object" string="Escalate Internally" invisible="dispute_state in ('internal','resolved','closed')"/><button name="action_resolve" type="object" string="Resolve Dispute" invisible="dispute_state in ('resolved','closed')"/><button name="action_close" type="object" string="Close Dispute" invisible="dispute_state != 'resolved'"/><field name="dispute_state" widget="statusbar"/></header><sheet><div class="alert alert-info" role="alert">Dispute Closed ≠ Financial Claim Closed. Resolution requires a documented business outcome; no write-off or recovery is inferred.</div><group><group><field name="issue_reference" readonly="id"/><field name="submission_id" readonly="id" domain="[('state','=','sent')]"/><field name="claim_id"/><field name="supplier_id"/><field name="claim_line_id" readonly="id"/><field name="response_id" readonly="id"/></group><group><field name="assigned_user_id" readonly="dispute_state == 'closed'"/><field name="priority" widget="priority" readonly="dispute_state == 'closed'"/><field name="next_action" readonly="dispute_state == 'closed'"/><field name="next_action_date" readonly="dispute_state == 'closed'"/><field name="contractual_deadline" readonly="dispute_state == 'closed'"/><field name="deadline_basis" readonly="dispute_state == 'closed'"/><field name="overdue"/><field name="company_id" groups="base.group_multi_company"/></group></group><field name="description" readonly="id"/><field name="evidence_ids" widget="many2many_tags" readonly="id"/><group string="Resolution"><field name="resolution_summary" readonly="not id or dispute_state == 'closed'"/><field name="resolved_by"/><field name="resolved_at"/></group><group><field name="recorded_by"/><field name="event_date"/></group></sheet></form></field></record>
<record id="action_supplier_disputes" model="ir.actions.act_window"><field name="name">Supplier Dispute Workbench</field><field name="res_model">supplier.shortage.claim.dispute</field><field name="view_mode">list,form</field></record>
<record id="view_claim_supplier_position" model="ir.ui.view"><field name="name">claim.supplier.position</field><field name="model">supplier.shortage.claim</field><field name="inherit_id" ref="view_claim_form"/><field name="arch" type="xml"><xpath expr="//notebook" position="inside"><page string="Supplier Response" groups="supplier_shortage_claim_reconciliation.group_claim_user,supplier_shortage_claim_reconciliation.group_accounts_reviewer"><div class="alert alert-info" role="alert">Supplier Accepted ≠ Financially Recovered. Supplier positions refer to the displayed submission revision. Review status requires new approval or supplier confirmation.</div><group><group><field name="response_submission_id"/><field name="supplier_response_status" widget="badge"/><field name="latest_verified_response_id"/><field name="last_supplier_response"/><field name="last_supplier_communication"/><field name="supplier_days_since_submission"/><field name="supplier_reply_target"/><field name="supplier_reply_target_kind"/><field name="next_supplier_followup"/><field name="open_dispute_count"/></group><group><field name="supplier_position_currency_id"/><field name="supplier_approved_amount"/><field name="supplier_accepted_amount" widget="monetary" options="{'currency_field': 'supplier_position_currency_id'}"/><field name="supplier_rejected_amount" widget="monetary" options="{'currency_field': 'supplier_position_currency_id'}"/><field name="supplier_disputed_amount" widget="monetary" options="{'currency_field': 'supplier_position_currency_id'}"/><field name="supplier_pending_amount" widget="monetary" options="{'currency_field': 'supplier_position_currency_id'}"/><field name="verified_recovery_amount"/><field name="promised_amount"/><field name="supplier_financial_review"/><field name="current_offer_id"/></group></group><notebook><page string="Supplier Decisions"><field name="response_ids" readonly="True"/></page><page string="Dispute Cases"><field name="dispute_ids" readonly="True"/></page><page string="Negotiation History"><field name="negotiation_ids" readonly="True"/></page><page string="Supplier Commitments"><field name="commitment_ids" readonly="True"/></page></notebook></page></xpath></field></record>
<menuitem id="menu_supplier_response_workbench" name="Supplier Responses" parent="menu_recovery_root" sequence="40" groups="supplier_shortage_claim_reconciliation.group_claim_user,supplier_shortage_claim_reconciliation.group_accounts_reviewer"/>
<menuitem id="menu_supplier_pending" name="Pending Verification" parent="menu_supplier_response_workbench" action="action_pending_supplier_responses" sequence="10"/>
